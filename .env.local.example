# Copy this file to .env.local and fill in real values. .env.local is
# gitignored by default in Next.js — never commit real secrets.

# Google Apps Script Web App URL for logging leads to a Google Sheet.
# See google-apps-script/leads.gs for the script + setup steps.
NEXT_PUBLIC_LEADS_WEBHOOK_URL=

# Resend API key for real automatic email sending. See RESEND_SETUP.md.
RESEND_API_KEY=

# Optional: only set this once a custom domain is verified in Resend.
# Until then, emails send from Resend's shared test address.
RESEND_FROM_EMAIL=
